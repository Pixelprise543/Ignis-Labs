# SI provider configuration. Copy to .env.local and fill in if you want live model
# answers. Without these values the app still works: every SI call falls back to
# the precomputed offline answers in data/si-fallback.json.

# openai | anthropic | openrouter | none
SI_PROVIDER=none

# Server-side only. Never import this into src/ - the dev middleware and api/si.ts
# read it from process.env, so the key never reaches the browser bundle.
SI_API_KEY=

# Model id for the chosen provider, e.g. gpt-4o-mini, claude-3-5-haiku, or a
# provider/model slug for routers. Leave empty to use the provider default.
SI_MODEL=
